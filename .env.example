# ═══════════════════════════════════════════════════════════════════════════════
# KEMIX Academy — Environment Variables Configuration Template
# Copy this file to .env and replace placeholders with your local/production values.
# NEVER commit the active .env file to Git!
# ═══════════════════════════════════════════════════════════════════════════════

# ── APPLICATION SETTINGS ──
NODE_ENV="development" # development | production | test
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000

# ── DATABASE CONNECTION (PostgreSQL 16+) ──
# Local Docker Compose PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kemix_academy_dev?schema=public"

# ── AUTHENTICATION & SECURITY ──
# Cryptographically secure random secret (min 32 characters)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-secure-32-byte-hex-secret-in-production"
COOKIE_SECURE="false" # Set to "true" in production behind HTTPS

# ── INITIAL ADMIN BOOTSTRAP (Optional Development / Initial Deployment Seeding) ──
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME=""


# ── OBJECT STORAGE (S3-Compatible Protocol) ──
# Works with MinIO (local dev), Cloudflare R2 (production), or AWS S3
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_PUBLIC_BUCKET="kemix-academy-public"
S3_PRIVATE_BUCKET="kemix-academy-protected"
S3_FORCE_PATH_STYLE="true" # Set "true" for MinIO; "false" for Cloudflare R2 / AWS S3

# ── TRANSACTIONAL EMAIL (Optional for Local Dev, logs to console if empty) ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@kemix.academy"
